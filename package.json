{
  "name": "aeroslate-efb",
  "productName": "AeroSlate EFB",
  "private": true,
  "version": "0.4.1",
  "description": "A free-tier, responsive SimBrief- and Navigraph-backed all-in-one flight-simulation EFB with encrypted GitHub cloud record sync.",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "check": "tsc -b --pretty false",
    "native:dev": "concurrently \"vite\" \"node --watch server/index.mjs\" \"wait-on http://localhost:5173 && electron .\"",
    "native:start": "electron .",
    "native:dist": "npm run build && electron-builder",
    "test:parser": "node tests/parser-regression.mjs",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.aeroslate.efb",
    "productName": "AeroSlate EFB",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/icons/aeroslate.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/aeroslate-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/aeroslate-512.png"
    }
  }
}
